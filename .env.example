# M0 backing bot configuration.
# Copy to .env for a manual launch or to /etc/m0bot.env for systemd.

# --- required -------------------------------------------------------------
# Telegram bot token from @BotFather.
TG_BOT_TOKEN=

# --- optional -------------------------------------------------------------
# Chat/channel for scheduled posts and alerts. Leave blank for commands only.
TG_CHAT_ID=

# An archive RPC (e.g. Alchemy) lets the bot discover all minters at startup.
# Left empty, it falls back to ~/.m0bot_rpc, then a public node.
RPC_URL=

# --- optional (defaults shown) ---------------------------------------------
ALERT_RATIO=1.00
EXPIRY_WARN_HOURS=6
REPORT_HOURS=8,16,24
REPORT_TZ=Europe/Prague
CHECK_MINUTES=60
# MINTER_LABELS=0xabc...=Name,0xdef...=Other
# EXTRA_MINTERS=0xabc...,0xdef...
# STATE_FILE=/var/lib/m0bot/m0bot_state.json   (set automatically under systemd)
