# M0 backing bot configuration.
# Copy to /etc/m0bot.env, fill in, then: sudo chown root:root /etc/m0bot.env && sudo chmod 600 /etc/m0bot.env
# systemd format: KEY=value, no quotes, no spaces around "=".

# --- required -------------------------------------------------------------
# New token from @BotFather (revoke the old one that was in the script).
TG_BOT_TOKEN=
# Chat/channel for scheduled posts and alerts (M0 group).
TG_CHAT_ID=-5298919281

# --- RPC ------------------------------------------------------------------
# An archive RPC (e.g. Alchemy) lets the bot discover all minters at startup.
# Left empty, it falls back to ~/.m0bot_rpc, then a public node.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- optional (defaults shown) ---------------------------------------------
ALERT_RATIO=1.00
EXPIRY_WARN_HOURS=6
REPORT_HOURS=8,16,24
REPORT_TZ=Europe/Prague
CHECK_MINUTES=60
# MINTER_LABELS=0xabc...=Name,0xdef...=Other
# EXTRA_MINTERS=0xabc...,0xdef...
# STATE_FILE=/var/lib/m0bot/m0bot_state.json   (set automatically under systemd)
